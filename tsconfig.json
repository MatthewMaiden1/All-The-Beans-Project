{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["es2017", "dom"],
    "outDir": "./All-The-Beans.Web/wwwroot/",
    "strict": true,
    "module": "esnext",
    "baseUrl": "UI", 
    "paths": {
        "@ts/*": ["ts/*"],
        "@modules/*": ["ts/modules/*"],
      },
    },
    "include": ["./All-The-Beans.Web/UI/ts/**/*"],
    "exclude": ["node_modules"]
}

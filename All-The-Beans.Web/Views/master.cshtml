<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - All The Beans</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script type="importmap"></script>
</head>
<body class="min-h-screen flex flex-col bg-stone-50 text-stone-900">

    @await Html.PartialAsync("~/Views/Partials/navbar.cshtml")

    <main class="flex-1 px-4 py-6 md:px-6 md:py-10 flex justify-center">
        <div class="w-full max-w-4xl">
            @RenderBody()
        </div>
    </main>

    @await Html.PartialAsync("~/Views/Partials/footer.cshtml")

    <script type="module" src="~/global.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

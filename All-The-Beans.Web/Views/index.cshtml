@page
@inject IWebHostEnvironment Env
@using System.Text.Json
@using AllTheBean.Core.Models
@{
    ViewData["Title"] = "Home";

    var json = System.IO.File.ReadAllText(System.IO.Path.Combine(Env.ContentRootPath, "Data", "allthebeans.json"));
    var allBeans    = JsonSerializer.Deserialize<List<Bean>>(json)!
        .Select(BeanViewModel.FromBean)
        .ToList();
    var beanOptions  = allBeans.Select(b => b.Name).ToList();
    var beanCosts    = allBeans.ToDictionary(b => b.Name, b => b.Cost);
    var beanOfTheDay = allBeans.FirstOrDefault(b => b.IsBeanOfTheDay);
}

<div class="flex flex-col gap-8">
    <div class="flex flex-col gap-2">
        <h1 class="text-4xl font-bold text-stone-900">All The Beans</h1>
        <p class="text-stone-500">Specialty coffee beans, sourced from around the world.</p>
    </div>


@if (beanOfTheDay is not null)
{
    <a href="/beanoftheday" class="flex flex-col items-center gap-2 bg-amber-50 border border-amber-200 rounded-xl px-6 py-8 text-center hover:bg-amber-100 hover:border-amber-400 transition-colors">
        <span class="text-xs font-semibold uppercase tracking-widest text-amber-600">Bean of the Day</span>
        <span class="text-3xl font-bold text-stone-900">@beanOfTheDay.Name</span>
        <span class="text-sm text-stone-500">@beanOfTheDay.Country &middot; @beanOfTheDay.Colour &middot; @beanOfTheDay.Cost</span>
    </a>
}

@await Html.PartialAsync("~/Views/Partials/orderForm.cshtml", new ViewDataDictionary(ViewData)
{
    { "beanOptions", beanOptions },
    { "beanCosts",   beanCosts   }
})

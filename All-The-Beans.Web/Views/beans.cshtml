@page
@inject IWebHostEnvironment Env
@using System.Text.Json
@using AllTheBean.Core.Models
@{
    var json = System.IO.File.ReadAllText(System.IO.Path.Combine(Env.ContentRootPath, "Data", "allthebeans.json"));
    var beans = JsonSerializer.Deserialize<List<Bean>>(json)!
        .Select(BeanViewModel.FromBean)
        .ToList();

    var selectedBeanName = Request.Query["bean"].ToString();
    var selectedBean = beans.FirstOrDefault(b =>
        string.Equals(b.Name, selectedBeanName, StringComparison.OrdinalIgnoreCase));

    ViewData["Title"] = selectedBean is not null ? selectedBean.Name : "Beans";
}

@if (selectedBean is not null)
{
    <div class="flex flex-col gap-8">
        <a href="/beans" class="text-sm text-stone-500 hover:text-stone-800">&larr; Back to all beans</a>

        <div class="flex flex-col md:flex-row gap-6 md:gap-8 items-start bg-white border border-stone-200 rounded-xl p-4 md:p-6">
            <img src="@selectedBean.Image" alt="@selectedBean.Name" class="w-full md:w-1/2 rounded-lg object-cover" />

            <div class="flex flex-col gap-3 flex-1">
                <h1 class="text-3xl font-bold text-stone-900">@selectedBean.Name</h1>
                <div class="flex gap-2">
                    <span class="text-xs font-medium bg-amber-100 text-amber-800 px-2 py-1 rounded">@selectedBean.Country</span>
                    <span class="text-xs font-medium bg-stone-100 text-stone-700 px-2 py-1 rounded">@selectedBean.Colour</span>
                </div>
                <span class="text-xl font-semibold text-amber-700">@selectedBean.Cost</span>
                <p class="text-sm text-stone-600 leading-relaxed">@selectedBean.Description</p>
            </div>
        </div>

        <div class="flex flex-col gap-4">
            <h2 class="text-xl font-semibold text-stone-900">Order this bean</h2>
            @await Html.PartialAsync("~/Views/Partials/orderForm.cshtml", new ViewDataDictionary(ViewData)
            {
                { "selectedBean", selectedBean.Name },
                { "beanOptions",  beans.Select(b => b.Name).ToList() },
                { "beanCosts",    beans.ToDictionary(b => b.Name, b => b.Cost) }
            })
        </div>
    </div>
}
else
{
    <div class="flex flex-col gap-6">
        <h1 class="text-3xl font-bold text-stone-900">Our Beans</h1>

        @await Html.PartialAsync("~/Views/Partials/searchBar.cshtml")

        <ul data-bean-list class="flex flex-col gap-3">
            @foreach (var bean in beans)
            {
                <li data-bean-item>
                    <a href="/beans?bean=@Uri.EscapeDataString(bean.Name)"
                       class="flex items-center justify-between border border-stone-200 rounded-lg px-5 py-4 bg-white hover:border-amber-400 hover:bg-amber-50 transition-colors">
                        <div class="flex flex-col gap-1">
                            <span class="text-base font-semibold text-stone-900">@bean.Name</span>
                            <span class="text-sm text-stone-500">@bean.Country &middot; @bean.Colour</span>
                        </div>
                        <span class="text-sm font-medium text-amber-700">@bean.Cost</span>
                    </a>
                </li>
            }
        </ul>
    </div>
}

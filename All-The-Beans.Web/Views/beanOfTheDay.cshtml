@page
@inject IWebHostEnvironment Env
@using System.Text.Json
@using AllTheBean.Core.Models
@{
    ViewData["Title"] = "Bean of the Day";

    var json = System.IO.File.ReadAllText(System.IO.Path.Combine(Env.ContentRootPath, "Data", "allthebeans.json"));
    var bean = JsonSerializer.Deserialize<List<Bean>>(json)!
        .Where(b => b.IsBOTD)
        .Select(BeanViewModel.FromBean)
        .FirstOrDefault();
}

@if (bean is not null)
{
    <div class="flex flex-col gap-6">
        <h1 class="text-3xl font-bold text-stone-900">Bean of the Day</h1>

        <div class="flex flex-col md:flex-row gap-6 md:gap-8 items-start bg-white border border-stone-200 rounded-xl p-4 md:p-6">
            <img src="@bean.Image" alt="@bean.Name" class="w-full md:w-1/2 rounded-lg object-cover" />

            <div class="flex flex-col gap-3 flex-1">
                <h2 class="text-2xl font-bold text-stone-900">@bean.Name</h2>
                <div class="flex gap-2">
                    <span class="text-xs font-medium bg-amber-100 text-amber-800 px-2 py-1 rounded">@bean.Country</span>
                    <span class="text-xs font-medium bg-stone-100 text-stone-700 px-2 py-1 rounded">@bean.Colour</span>
                </div>
                <span class="text-xl font-semibold text-amber-700">@bean.Cost</span>
                <p class="text-sm text-stone-600 leading-relaxed">@bean.Description</p>
            </div>
        </div>
    </div>
}
else
{
    <p class="text-stone-500">No bean of the day selected.</p>
}

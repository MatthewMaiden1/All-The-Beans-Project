@using System.Text.Json
@{
    var selectedBean = ViewData["selectedBean"] as string ?? "";
    var beanOptions  = ViewData["beanOptions"] as List<string>;
    var beanCosts    = ViewData["beanCosts"] as Dictionary<string, string>;
    var beanCostsJson = beanCosts is not null
        ? JsonSerializer.Serialize(beanCosts)
        : "{}";
}

<form method="post" action="/order/submit" data-form="order"
      data-bean-costs="@beanCostsJson"
      class="flex flex-col gap-4 w-full max-w-md">
    @Html.AntiForgeryToken()

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="flex flex-col gap-1">
            <label for="firstName" class="text-sm font-medium text-stone-700">First Name</label>
            <input type="text" id="firstName" name="firstName" data-field
                   class="border border-stone-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400" />
            <span data-error="firstName" class="text-xs text-red-500" hidden></span>
        </div>

        <div class="flex flex-col gap-1">
            <label for="lastName" class="text-sm font-medium text-stone-700">Last Name</label>
            <input type="text" id="lastName" name="lastName" data-field
                   class="border border-stone-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400" />
            <span data-error="lastName" class="text-xs text-red-500" hidden></span>
        </div>
    </div>

    <div class="flex flex-col gap-1">
        <label for="email" class="text-sm font-medium text-stone-700">Email</label>
        <input type="email" id="email" name="email" data-field
               class="border border-stone-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400" />
        <span data-error="email" class="text-xs text-red-500" hidden></span>
    </div>

    <div class="flex flex-col gap-1">
        <label for="phone" class="text-sm font-medium text-stone-700">Phone Number</label>
        <input type="tel" id="phone" name="phone" data-field
               class="border border-stone-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400" />
        <span data-error="phone" class="text-xs text-red-500" hidden></span>
    </div>

    <div class="flex flex-col gap-1">
        <label for="address" class="text-sm font-medium text-stone-700">Address</label>
        <input type="text" id="address" name="address" data-field
               class="border border-stone-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400" />
        <span data-error="address" class="text-xs text-red-500" hidden></span>
    </div>

    <div class="flex flex-col gap-1">
        <label for="beanType" class="text-sm font-medium text-stone-700">Select Your Bean</label>
        <select id="beanType" name="beanType" data-field
                class="border border-stone-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400">
            <option value="">-- Choose a bean --</option>
            @if (beanOptions is not null)
            {
                @foreach (var option in beanOptions)
                {
                    <option value="@option" selected="@(option == selectedBean ? "selected" : null)">@option</option>
                }
            }
        </select>
        <span data-error="beanType" class="text-xs text-red-500" hidden></span>
    </div>

    <div class="flex items-end gap-4">
        <div class="flex flex-col gap-1">
            <label for="quantity" class="text-sm font-medium text-stone-700">Quantity (bags)</label>
            <input type="number" id="quantity" name="quantity" min="1" max="99" value="1" data-field
                   class="border border-stone-300 rounded px-3 py-2 text-sm w-24 focus:outline-none focus:ring-2 focus:ring-amber-400" />
            <span data-error="quantity" class="text-xs text-red-500" hidden></span>
        </div>
        <p data-price-display hidden class="text-base font-semibold text-amber-700 pb-2"></p>
    </div>

    <div style="display:none" aria-hidden="true">
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <button type="submit" class="mt-2 bg-amber-800 text-white text-sm font-medium px-4 py-2 rounded hover:bg-amber-900 transition-colors">
        Order Now
    </button>
</form>
